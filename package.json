{
  "name": "arrowpuck",
  "version": "1.0.0",
  "description": "Non-intrusive interactive easter egg micro-widget with zero dependencies",
  "type": "module",
  "main": "dist/arrowpuck.min.js",
  "module": "dist/arrowpuck.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/arrowpuck.min.js",
  "jsdelivr": "dist/arrowpuck.min.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arrowpuck.esm.js",
      "require": "./dist/arrowpuck.min.js",
      "default": "./dist/arrowpuck.min.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "node demo/serve.js",
    "start": "node demo/serve.js",
    "test": "node tests/test_physics_collision.js"
  },
  "keywords": [
    "widget",
    "canvas",
    "easter-egg",
    "vanilla-js",
    "interactive",
    "physics",
    "game",
    "arrow"
  ],
  "author": "Arif S.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arifsevban/arrowpuck.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.34.8"
  }
}
